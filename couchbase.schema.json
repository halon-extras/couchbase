{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"description": "Configure Couchbase cluster connection profiles used by the Couchbase() function.",
	"additionalProperties": false,
	"required": [
		"profiles"
	],
	"properties": {
		"default": {
			"type": "object",
			"description": "Default profile and bucket.",
			"additionalProperties": false,
			"required": [
				"profile",
				"bucket"
			],
			"properties": {
				"profile": {
					"type": "string",
					"minLength": 1,
					"description": "The default profile."
				},
				"bucket": {
					"type": "string",
					"minLength": 1,
					"description": "The default bucket."
				}
			}
		},
		"profiles": {
			"type": "array",
			"description": "Couchbase cluster connection profiles.",
			"minItems": 1,
			"items": {
				"type": "object",
				"description": "A Couchbase cluster connection profile.",
				"additionalProperties": false,
				"required": [
					"id",
					"connection_string"
				],
				"oneOf": [
					{
						"required": [
							"certificate",
							"private_key"
						],
						"properties": {
							"connection_string": {
								"pattern": "^couchbases://"
							}
						},
						"not": {
							"anyOf": [
								{
									"required": ["username"]
								},
								{
									"required": ["password"]
								}
							]
						}
					},
					{
						"required": [
							"username",
							"password"
						],
						"not": {
							"anyOf": [
								{
									"required": ["certificate"]
								},
								{
									"required": ["private_key"]
								}
							]
						}
					}
				],
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1,
						"description": "Unique profile ID passed to Couchbase()."
					},
					"connection_string": {
						"type": "string",
						"minLength": 1,
						"description": "Couchbase connection string, for example couchbase://db.example.com or couchbases://db.example.com."
					},
					"username": {
						"type": "string",
						"minLength": 1,
						"description": "Username used to authenticate with the cluster."
					},
					"password": {
						"type": "string",
						"minLength": 1,
						"description": "Password used to authenticate with the cluster."
					},
					"certificate": {
						"type": "string",
						"minLength": 1,
						"description": "Path to the client certificate used to authenticate with the cluster."
					},
					"private_key": {
						"type": "string",
						"minLength": 1,
						"description": "Path to the client private key used to authenticate with the cluster."
					},
					"trust_store": {
						"type": "string",
						"minLength": 1,
						"description": "Path to the CA certificate used to verify the cluster."
					}
				}
			}
		}
	}
}